# Environment variables for production

APP_NAME="Employee Attendance Management System"
DEBUG=False
SECRET_KEY="supersecretkey-change-in-production"

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Database path (Example uses a Railway volume mount path)
# Assuming you add a volume in Railway at /app/data
DATABASE_URL="sqlite:////app/data/attendance.db"

# Geofencing
COMPANY_LATITUDE=30.0444
COMPANY_LONGITUDE=31.2357
ALLOWED_RADIUS_METERS=50

# CORS - Set to your production frontend URL, or "*" for all
CORS_ORIGINS="*"
